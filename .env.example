# COCOCHOI AI CONTENT FACTORY 설정 예시
# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
# .env 파일은 GitHub에 올라가지 않습니다. 실제 키는 .env 에만 적으세요.

# AI 공급자 (Phase 1에서 사용)
ANTHROPIC_API_KEY=

# 프로그램 데이터 폴더 (비워두면 storage/ 사용)
STORAGE_DIR=

# FFmpeg 위치 (비워두면 자동으로 찾음. 찾지 못할 때만 ffmpeg.exe 전체 경로를 적으세요)
FFMPEG_PATH=
FFPROBE_PATH=
